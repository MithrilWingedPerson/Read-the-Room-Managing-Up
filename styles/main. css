@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap');

:root{--ink:#202c3b;--muted:#647181;--paper:#f6f4ef;--white:#fff;--teal:#2e7775;--teal-dark:#205b5a;--coral:#d77c62;--line:#e4e1da;--gold:#d9b66d;--shadow:0 18px 50px rgba(32,44,59,.09)}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:"DM Sans",Arial,sans-serif;line-height:1.55}
a{color:inherit;text-decoration:none}
button{font:inherit}
.topbar{height:78px;padding:0 clamp(20px,6vw,88px);display:flex;align-items:center;justify-content:space-between;background:rgba(246,244,239,.94);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:5;backdrop-filter:blur(12px)}
.brand{display:flex;align-items:center;gap:11px;font-size:12px;font-weight:700;letter-spacing:.13em;line-height:1.2}
.brand-mark{display:grid;place-items:center;width:36px;height:36px;border-radius:11px;background:var(--ink);color:white;font-family:"Playfair Display",serif;font-size:22px;letter-spacing:0}
.brand-sub{display:block;color:var(--muted);font-size:9px;letter-spacing:.22em;margin-top:4px}
.main-nav{display:flex;gap:32px;align-items:center}
.nav-link{font-size:13px;color:var(--muted);padding:9px 0;border-bottom:2px solid transparent}
.nav-link:hover,.nav-link.active{color:var(--ink);border-color:var(--teal)}
.menu-toggle{display:none;border:0;background:none;color:var(--ink);font-size:23px}
main{min-height:calc(100vh - 140px)}
.page{display:none;max-width:1440px;margin:auto;padding:0 clamp(20px,6vw,88px) 70px}
.page.active{display:block}
.hero{min-height:570px;display:grid;grid-template-columns:1.03fr .97fr;align-items:center;gap:30px;padding:55px 0 65px}
.eyebrow{font-size:10px;letter-spacing:.2em;font-weight:700;color:var(--teal);margin:0 0 16px}
h1,h2,p{margin-top:0}
h1,h2{line-height:1.13}
h1{font-family:"Playfair Display",Georgia,serif;font-size:clamp(42px,6vw,76px);font-weight:600;letter-spacing:-.035em;margin-bottom:22px}
h1 em{color:var(--teal);font-weight:600}
.hero-intro{max-width:510px;color:var(--muted);font-size:17px;line-height:1.75}
.hero-actions{display:flex;align-items:center;gap:25px;margin-top:32px}
.button{display:inline-flex;align-items:center;justify-content:center;gap:18px;padding:14px 20px;border-radius:7px;border:0;font-weight:700;font-size:13px;cursor:pointer;transition:transform .18s,background .18s}
.button:hover{transform:translateY(-2px)}
.button-primary{background:var(--teal);color:white}
.button-primary:hover{background:var(--teal-dark)}
.text-link{font-size:13px;font-weight:700;color:var(--ink);border-bottom:1px solid var(--gold);padding-bottom:4px}
.hero-art{height:410px;position:relative;border-radius:48% 48% 16px 16px;background:#e7e7df;overflow:hidden;display:flex;align-items:end;justify-content:center}
.hero-art:before{content:"";position:absolute;width:310px;height:310px;border-radius:50%;background:#d4dfd7;top:55px;left:50%;transform:translateX(-50%)}
.orbit{position:absolute;border:1px solid rgba(46,119,117,.25);border-radius:50%;z-index:1}
.orbit-one{width:360px;height:360px;top:28px;left:50%;transform:translateX(-50%)}
.orbit-two{width:420px;height:420px;top:-2px;left:50%;transform:translateX(-50%)}
.figure{position:absolute;z-index:2;bottom:47px;width:145px;height:245px}
.figure .head{position:absolute;width:82px;height:94px;border-radius:45% 45% 43% 43%;top:0;left:32px;background:#b97859}
.figure .body{position:absolute;width:145px;height:175px;border-radius:55px 55px 12px 12px;bottom:0;background:#315c61}
.figure-back{left:calc(50% - 150px);transform:scale(.88);transform-origin:bottom}
.figure-back .head{background:#8d604b}.figure-back .body{background:#bd8b68}
.figure-front{left:calc(50% + 5px)}
.figure-front .head{background:#d39b75}.figure-front .body{background:#293c50}
.speech{position:absolute;z-index:3;background:white;border-radius:12px;padding:11px 14px;font-size:12px;font-weight:700;box-shadow:var(--shadow)}
.speech-one{top:80px;left:9%}.speech-two{top:150px;right:7%}
.art-caption{position:absolute;z-index:3;bottom:15px;color:#50625f;font-size:10px;letter-spacing:.08em;text-transform:uppercase}
.intro-strip{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:48px 0;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.intro-strip h2{font-family:"Playfair Display",serif;font-size:clamp(25px,3vw,38px);font-weight:600;margin:0}
.intro-strip>p{max-width:490px;color:var(--muted);line-height:1.8;margin:0}
.challenge-preview{padding:62px 0 20px}
.section-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:25px;gap:20px}
.section-heading h2,.page-heading h1{font-family:"Playfair Display",serif;font-size:clamp(30px,4vw,46px);font-weight:600;margin:0}
.mini-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.mini-card,.challenge-card,.guide-card{background:var(--white);border:1px solid var(--line);border-radius:10px;padding:23px}
.mini-card{display:flex;gap:14px;align-items:center}
.mini-num{font-family:"Playfair Display",serif;color:var(--coral);font-size:25px}
.mini-card strong{display:block;font-size:13px}.mini-card small{color:var(--muted);font-size:11px}
.page-heading{padding:65px 0 35px;max-width:760px}
.page-heading h1{margin-bottom:15px}
.page-heading>p:last-child{color:var(--muted);max-width:630px}
.progress-panel{background:#ebe9e2;border-radius:9px;padding:18px 22px;margin-bottom:23px;display:flex;align-items:center;gap:28px}
.progress-copy{display:flex;flex-direction:column;min-width:145px;gap:3px}
.progress-label,.small-label{font-size:9px;letter-spacing:.16em;font-weight:700;color:var(--muted)}
.progress-copy strong{font-size:13px}
.progress-track{height:7px;background:#d7d5ce;border-radius:99px;overflow:hidden;flex:1}
.progress-track span{display:block;width:0;height:100%;background:var(--teal);transition:width .3s}
.challenge-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.challenge-card{position:relative;min-height:210px;display:flex;flex-direction:column;align-items:flex-start;transition:transform .18s,box-shadow .18s}
.challenge-card:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.card-top{display:flex;justify-content:space-between;align-items:center;width:100%;margin-bottom:17px}
.card-number{font-family:"Playfair Display",serif;color:var(--coral);font-size:27px}
.status{font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);background:#f0efeb;padding:6px 9px;border-radius:99px}
.challenge-card h2{font-family:"Playfair Display",serif;font-size:23px;font-weight:600;margin:0 0 8px}
.challenge-card p{font-size:12px;color:var(--muted);margin:0 0 19px;max-width:290px}
.card-footer{margin-top:auto;display:flex;justify-content:space-between;align-items:center;width:100%;font-size:11px;font-weight:700}
.card-arrow{color:var(--teal);font-size:18px}
.prototype-note{margin-top:24px;padding:14px 17px;background:#eeece5;border-left:3px solid var(--gold);color:var(--muted);font-size:12px}
.guide-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:15px}
.guide-card{min-height:180px}
.guide-number{font-family:"Playfair Display",serif;font-size:28px;color:var(--coral)}
.guide-card h2{font-family:"Playfair Display",serif;font-size:22px;margin:15px 0 8px}
.guide-card p{font-size:13px;color:var(--muted);margin:0;max-width:460px}
.principle-card{margin-top:22px;background:var(--ink);color:white;border-radius:10px;padding:32px}
.principle-card .eyebrow{color:#a8d0c8}
.principle-card h2{font-family:"Playfair Display",serif;font-size:clamp(22px,3vw,34px);font-weight:600;max-width:900px;margin:0}
.footer{border-top:1px solid var(--line);padding:22px clamp(20px,6vw,88px);display:flex;justify-content:space-between;gap:20px;color:var(--muted);font-size:9px;letter-spacing:.1em}
.challenge-dialog{width:min(92vw,480px);border:0;border-radius:13px;padding:34px;box-shadow:0 25px 80px rgba(20,30,40,.25);color:var(--ink)}
.challenge-dialog::backdrop{background:rgba(20,30,40,.55);backdrop-filter:blur(3px)}
.dialog-close{position:absolute;right:15px;top:10px;border:0;background:none;font-size:28px;color:var(--muted);cursor:pointer}
.challenge-dialog h2{font-family:"Playfair Display",serif;font-size:32px;margin:0 0 12px}
.challenge-dialog>p:not(.eyebrow){font-size:13px;color:var(--muted);line-height:1.7}
.dialog-manager{display:flex;align-items:center;gap:12px;background:#f2f1ec;padding:13px;border-radius:8px;margin:20px 0}
.dialog-manager>div{display:flex;flex-direction:column;gap:3px;font-size:13px}
.manager-avatar{width:39px;height:39px;border-radius:50%;background:linear-gradient(145deg,#d49a76 0 45%,#315c61 46%);display:block}
.dialog-status{padding:12px;background:#f8f3e8;border-radius:7px;font-size:11px!important}
@media(max-width:800px){.hero{grid-template-columns:1fr;padding-top:45px}.hero-art{height:340px;max-width:520px;width:100%;margin:0 auto}.intro-strip{grid-template-columns:1fr;gap:20px}.challenge-grid{grid-template-columns:repeat(2,1fr)}.mini-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.topbar{height:66px}.menu-toggle{display:block}.main-nav{display:none;position:absolute;top:65px;left:0;right:0;background:var(--paper);padding:15px 22px 20px;border-bottom:1px solid var(--line);flex-direction:column;align-items:flex-start;gap:12px}.main-nav.open{display:flex}.hero{min-height:auto;padding:42px 0}.hero-art{height:300px}.hero-intro{font-size:15px}.hero-actions{align-items:flex-start;flex-direction:column;gap:17px}.intro-strip{padding:35px 0}.section-heading{align-items:flex-start;flex-direction:column}.challenge-grid,.mini-grid,.guide-grid{grid-template-columns:1fr}.page-heading{padding:43px 0 25px}.progress-panel{align-items:flex-start;flex-direction:column;gap:12px}.progress-track{width:100%;flex:auto}.footer{flex-direction:column;gap:7px}.challenge-card{min-height:190px}}
